# NARA HOUSE — environment configuration
#
# This is the committed template, and the only `.env*` file that is tracked.
# Copy it and edit the copy:
#
#     cp .env.example .env.local
#
# Every variable below is optional. The project installs, runs, tests and builds
# with none of them set — they exist to override defaults that are deliberately
# inert rather than to supply anything missing. There are no secrets here, and
# none belong here.


# The absolute base for canonical URLs, Open Graph tags, robots.txt and
# sitemap.xml. Read by src/app/layout.tsx, src/app/robots.ts and
# src/app/sitemap.ts.
#
# The default is https://nara.jedsada-payakorn.com — the studio subdomain the
# site is actually served from (see the custom domain in wrangler.jsonc). The
# earlier default was https://nara-house.example, a reserved TLD that can never
# resolve; that was the safe state while the site had no address, but once it
# was deployed it meant every canonical URL, og:image and sitemap entry pointed
# at a domain that does not exist. The brand is still fictional — the site says
# so in its own copy — but the address it advertises has to be the real one.
#
# Set it only to override that: a preview deployment advertising its own origin,
# with no trailing slash.
#
# NEXT_PUBLIC_ inlines the value into the client bundle at build time, so it has
# to be set for `next build`, not for `next start`. Anything behind this prefix
# is public by definition — never put a secret here.
NEXT_PUBLIC_SITE_URL=https://nara.jedsada-payakorn.com


# Absolute path to an ffmpeg binary, used only by `npm run generate:media`. The
# script checks this first, then Playwright's bundled binary, then a system
# install; with none of them it skips the clips and says so. The generated media
# is committed, so this is not needed for dev, test or build.
# FFMPEG_PATH=/usr/bin/ffmpeg


# Port for the Playwright suite — both the server it starts and the base URL it
# points at (playwright.config.ts). Defaults to 3000.
# PORT=3000


# Note: playwright.config.ts also reads CI, to forbid `test.only`, enable
# retries and switch reporters. Continuous-integration providers set it
# themselves; it is not something to put in a local .env file.
